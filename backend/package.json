{
  "name": "biltoki-pennylane-sync",
  "version": "1.0.0",
  "description": "Pennylane sync backend for Biltoki merchants portal",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc",
    "start": "prisma migrate deploy && node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --config ../eslint.config.js src",
    "typecheck": "tsc --noEmit",
    "pennylane:inspect": "tsx src/scripts/inspect-pennylane.ts",
    "prisma:studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:reset": "prisma migrate reset --force",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate deploy && prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.10.0",
    "@supabase/supabase-js": "^2.112.3",
    "dotenv": "^18.0.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0",
    "pino": "^8.16.2",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.3",
    "tsx": "^4.7.0",
    "typescript": "~6.0.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "mysql2": "^3.24.5",
    "deepmerge-ts": "^8.0.2"
  }
}
