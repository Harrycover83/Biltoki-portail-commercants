# Backend Env Variables

# Supabase (required)
VITE_SUPABASE_URL=https://ocgesbspdhxisnrzotfx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Pennylane API (will be populated later)
PENNYLANE_API_KEY=
PENNYLANE_API_URL=https://api.pennylane.io

# Server config
NODE_ENV=development
PORT=3000

# Biltoki config
# Comma-separated hall UUIDs (supports multi-hall)
# Example: "uuid-1,uuid-2,uuid-3"
HALLS_TO_SYNC=

# Sync schedule (cron format)
# 0 2 * * * = Every day at 2 AM
SYNC_CRON_SCHEDULE=0 2 * * *

# Logging
LOG_LEVEL=info
