# Backend Env Variables

# Supabase (required)
VITE_SUPABASE_URL=https://ocgesbspdhxisnrzotfx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Pennylane API (Company API v2, token scoped to ONE Pennylane company)
PENNYLANE_API_KEY=
PENNYLANE_API_URL=https://app.pennylane.com/api/external/v2

# Server config
NODE_ENV=development
PORT=3000

# API security
# Machine-to-machine token for ops tooling (header: x-internal-token). Min 32 chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=
# Comma-separated browser origins allowed to call /api (the portal URL)
ALLOWED_ORIGINS=

# Biltoki config
# Comma-separated hall UUIDs (supports multi-hall)
# Example: "uuid-1,uuid-2,uuid-3"
HALLS_TO_SYNC=

# Sync schedule (cron format)
# 0 2 * * * = Every day at 2 AM
SYNC_CRON_SCHEDULE=0 2 * * *

# Logging
LOG_LEVEL=info
