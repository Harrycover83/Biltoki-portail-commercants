# --- Base de données ---------------------------------------------------------
# Connexion PostgreSQL utilisée par Prisma pour appliquer les migrations.
# Supabase > Project Settings > Database > Connection pooling (URI).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres

# --- Supabase (obligatoire) --------------------------------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Pennylane (API Company v2, jeton limité à UNE société) ------------------
PENNYLANE_API_KEY=
PENNYLANE_API_URL=https://app.pennylane.com/api/external/v2

# --- Serveur -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Sécurité de l'API -------------------------------------------------------
# Jeton machine-à-machine (en-tête x-internal-token), 32 caractères minimum.
# Génération : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=
# Origines navigateur autorisées à appeler /api, séparées par des virgules (URL du portail).
ALLOWED_ORIGINS=
# Nombre de reverse proxies devant l'API, pour identifier l'IP réelle du client (limitation de débit).
# Défaut : 1 en production, 0 sinon.
TRUST_PROXY_HOPS=

# --- Synchronisation ---------------------------------------------------------
# UUID des halles à synchroniser, séparés par des virgules (obtenus via `npm run prisma:seed`).
HALLS_TO_SYNC=
# Expression cron de la synchronisation planifiée (défaut : tous les jours à 2 h).
SYNC_CRON_SCHEDULE=0 2 * * *
